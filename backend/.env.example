# ==========================================================
# Sistema Educa - configuracion del backend (plantilla)
# ==========================================================
# Copia este archivo a backend/.env y cambia los valores.
# El archivo .env esta en .gitignore: NUNCA se versiona, porque
# guarda secretos. Este .env.example si se versiona, porque solo
# contiene valores de ejemplo.
#
#   cd backend
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (Linux / macOS)
# ==========================================================

# Entorno: development | production
NODE_ENV=development

# Servidor
PORT=3000
HOST=127.0.0.1

# Origenes con permiso de CORS, separados por coma.
# Debe incluir la direccion desde la que se sirve el frontend.
# No se admite el comodin * porque la API envia cookies de sesion.
ORIGENES_PERMITIDOS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# --------------------------------------------------------------
# SECRETO DE SESION - OBLIGATORIO
# --------------------------------------------------------------
# Cadena aleatoria de al menos 32 caracteres. Se usa para firmar los
# tokens CSRF y cualquier valor sellado.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_SESION=cambia-esta-cadena-por-una-aleatoria-de-64-caracteres

# --------------------------------------------------------------
# BASE DE DATOS
# --------------------------------------------------------------
# Ruta relativa a la carpeta backend/. El esquema se toma de
# base-datos/esquema.sql y se aplica al arrancar.
BASE_DATOS=datos/educa.db

# --------------------------------------------------------------
# CONTRASENAS
# --------------------------------------------------------------
# Costo de derivacion con scrypt (2^n). 32768 = 2^15, el valor
# recomendado por OWASP. Subirlo aumenta la seguridad y tambien
# el tiempo de respuesta del inicio de sesion.
COSTE_SCRYPT=32768

# --------------------------------------------------------------
# SESIONES
# --------------------------------------------------------------
NOMBRE_COOKIE=educa_sesion
DURACION_SESION_HORAS=8
DURACION_SESION_RECORDAR_DIAS=30

# --------------------------------------------------------------
# LIMITES (throttling y abuso)
# --------------------------------------------------------------
LIMITE_LOGIN_VENTANA_MINUTOS=15
LIMITE_LOGIN_MAX_INTENTOS=5
LIMITE_REGISTRO_VENTANA_MINUTOS=60
# Altas de cuenta por IP y hora. El contador es por IP, asi que detras de un
# NAT compartido (aula, facultad) todas las cuentas consumen del mismo cupo.
LIMITE_REGISTRO_MAX_INTENTOS=20
LIMITE_GENERAL_VENTANA_MINUTOS=1
LIMITE_GENERAL_MAX_PETICIONES=120

# Tamano maximo del cuerpo de una peticion, en bytes (16 KB).
CORPULO_MAXIMO_BYTES=16384
